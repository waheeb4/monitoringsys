  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const method = pm.request.method;",
          "",
          "// Only intercept state-modifying requests",
          "if (['PATCH', 'POST', 'PUT', 'DELETE'].includes(method)) {",
          "    const csrfToken = pm.collectionVariables.get(\"xsrf_token\");",
          "    const jwtToken = pm.collectionVariables.get(\"access_token\") || pm.environment.get(\"access_token\");",
          "    ",
          "    if (csrfToken) {",
          "        // 1. Always inject the CSRF Custom Header to bypass 403s",
          "        pm.request.headers.upsert({",
          "            key: 'X-XSRF-TOKEN',",
          "            value: csrfToken",
          "        });",
          "        ",
          "        // 2. Check if the test is intentionally testing an unauthenticated state",
          "        if (jwtToken && !pm.info.requestName.includes(\"No Token\")) {",
          "            // Standard authenticated request: Attach both",
          "            pm.request.headers.upsert({",
          "                key: 'Cookie',",
          "                value: `XSRF-TOKEN=${csrfToken}; token=${jwtToken}`",
          "            });",
          "        } else {",
          "            // \"No Token\" request: Attach ONLY the CSRF token, intentionally hiding the JWT",
          "            pm.request.headers.upsert({",
          "                key: 'Cookie',",
          "                value: `XSRF-TOKEN=${csrfToken}`",
          "            });",
          "        }",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Safely check ALL headers to reliably catch the rotating token",
          "const allHeaders = pm.response.headers.all();",
          "const cookieHeaders = allHeaders.filter(h => h.key.toLowerCase() === 'set-cookie');",
          "",
          "for (let header of cookieHeaders) {",
          "    if (header.value.includes('XSRF-TOKEN=')) {",
          "        const match = header.value.match(/XSRF-TOKEN=([^;]+)/);",
          "        if (match) {",
          "            pm.collectionVariables.set(\"xsrf_token\", match[1]);",
          "            break;",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  ],
