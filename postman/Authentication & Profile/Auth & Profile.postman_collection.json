    {
      "name": "Health",
      "item": [
        {
          "name": "TC15 — Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const setCookieHeader = pm.response.headers.get(\"Set-Cookie\");",
                  "",
                  "if (setCookieHeader && setCookieHeader.includes(\"XSRF-TOKEN\")) {",
                  "    const match = setCookieHeader.match(/XSRF-TOKEN=([^;]+)/);",
                  "    if (match) {",
                  "        // CHANGED: Use collectionVariables instead of environment",
                  "        pm.collectionVariables.set(\"xsrf_token\", match[1]);",
                  "        console.log(\"CSRF Token dynamically captured from TC15 and saved!\");",
                  "    } else {",
                  "        console.warn(\"XSRF-TOKEN cookie found, but failed to parse the value.\");",
                  "    }",
                  "} else {",
                  "    console.warn(\"No Set-Cookie header with XSRF-TOKEN found in the response.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/heartbeat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "heartbeat"
              ]
            }
          },
          "response": []
        }
      ]
    },
