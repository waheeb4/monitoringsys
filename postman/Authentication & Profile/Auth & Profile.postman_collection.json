    {
      "name": "Users — Profile",
      "item": [
        {
          "name": "TC08 — Fetch Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract the fresh token generated AFTER login",
                  "const setCookieHeader = pm.response.headers.get(\"Set-Cookie\");",
                  "",
                  "if (setCookieHeader && setCookieHeader.includes(\"XSRF-TOKEN\")) {",
                  "    const match = setCookieHeader.match(/XSRF-TOKEN=([^;]+)/);",
                  "    if (match) {",
                  "        pm.collectionVariables.set(\"xsrf_token\", match[1]);",
                  "        console.log(\"Fresh CSRF Token captured after login and saved!\");",
                  "    }",
                  "}",
                  "pm.test('TC08 — Returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('TC08 — Returns user data', function () {",
                  "    const body = pm.response.json();",
                  "    const user = body.user || body;",
                  "    pm.expect(user).to.have.property('email');",
                  "});",
                  "",
