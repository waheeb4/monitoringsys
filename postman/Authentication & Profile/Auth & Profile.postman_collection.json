    {
      "name": "Auth — Signup",
      "item": [
        {
          "name": "TC01 — Successful Registration",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Destroy any stale environment variables that are shadowing our new data",
                  "const varsToClear = [",
                  "    'test_email', 'test_fname', 'test_lname', ",
                  "    'test_password', 'test_new_password', 'access_token', 'xsrf_token'",
                  "];",
                  "varsToClear.forEach(v => pm.environment.unset(v));",
                  "",
                  "// 2. Generate the brand new, unique data for this specific test run",
                  "const unique = `${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;",
                  "pm.collectionVariables.set('test_email', `testuser_${unique}@example.com`);",
                  "pm.collectionVariables.set('test_fname', 'Test');",
                  "pm.collectionVariables.set('test_lname', 'User');",
                  "pm.collectionVariables.set('test_password', 'StrongPass@1');",
                  "pm.collectionVariables.set('test_new_password', 'NewStrong@2'); ",
                  "",
                  "console.log('Generated and set fresh email:', pm.collectionVariables.get('test_email'));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC01 — Returns 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('TC01 — Returns JWT token', function () {",
                  "    const body = pm.response.json();",
                  "    const token = body.token || body.accessToken || body.access_token;",
                  "    pm.expect(token).to.be.a('string');",
                  "    pm.expect(token.length).to.be.greaterThan(0);",
                  "    pm.collectionVariables.set('access_token', token);",
                  "});",
                  "",
                  "pm.test('TC01 — Returns user object', function () {",
                  "    const body = pm.response.json();",
                  "    const user = body.user || body;",
                  "    pm.expect(user).to.have.any.keys('id', '_id');",
                  "    pm.expect(user).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
